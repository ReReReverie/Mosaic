# Default provider. Keep this server-side in .env.local or the Docker environment.
# Leave blank to use the deterministic local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional fallback provider for existing deployments.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional personal-provider support for server-side fallback configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Groq (free tier available at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Replicate (MiniCPM-V image/video model)
# The app sends one resized image per request; video scanning remains skipped.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=sai88uk/minicpm-v-45-v9:5f9e86550c3540aab9292e0cae22f71bb75724be3c9bb72ebf0798d028f0f27b

# Ollama (local, no API key required)
# Set OLLAMA_ENABLED=true to use Ollama as the server-side fallback.
# Override the base URL if Ollama is not running on the default port.
OLLAMA_ENABLED=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# AI reference analysis is enabled by default when a provider is configured.
# Set false to keep analysis local and deterministic.
MOSAIC_VISION_ENABLED=true
MOSAIC_VISION_MAX_FILES=50
# Maximum concurrent AI reference enrichments (1-4). Default: 4.
MOSAIC_AI_MAX_CONCURRENCY=4
