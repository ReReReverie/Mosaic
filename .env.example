# Default hosted provider. Keep this server-side in Vercel or .env.local.
# Leave blank to use the deterministic local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback provider for existing deployments.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional personal-provider support for server-side fallback configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional: Neon PostgreSQL connection string. Leave blank for now. Keep it
# server-side; never prefix it with NEXT_PUBLIC_.
DATABASE_URL=
